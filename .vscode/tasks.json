{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "docker: up (build)",
      "type": "shell",
      "command": "docker compose --env-file .env.development -f docker-compose.debug.yaml up -d --build",
      "problemMatcher": []
    },
    {
      "label": "docker: down",
      "type": "shell",
      "command": "docker compose --env-file .env.development -f docker-compose.debug.yaml down",
      "problemMatcher": []
    },
    {
      "label": "docker: restart backend",
      "type": "shell",
      "command": "docker compose --env-file .env.development -f docker-compose.debug.yaml up -d --build backend",
      "problemMatcher": []
    },
    {
      "label": "docker: logs backend",
      "type": "shell",
      "command": "docker compose --env-file .env.development -f docker-compose.debug.yaml logs -f backend",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "wait for backend",
      "type": "shell",
      "command": "until curl -s http://localhost:8000/actuator/health > /dev/null; do sleep 2; done",
      "problemMatcher": [],
      "dependsOn": ["docker: up (build)"]
    }
  ]
}
